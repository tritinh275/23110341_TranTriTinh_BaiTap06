<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/public/css/custom.css" />
    <title>Theo dõi đơn hàng</title>
  </head>
  <body class="bg-slate-100 text-slate-800">
    <header class="bg-white border-b border-slate-200 sticky top-0 z-10">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="text-xl font-bold text-blue-700">SneakerHub</a>
        <div class="flex items-center gap-3 text-sm">
          <a href="/cart" class="px-3 py-1.5 rounded-lg border border-slate-300 hover:bg-slate-50">
            Giỏ hàng
            <span id="cartCount" class="ml-1 inline-flex items-center justify-center text-xs bg-blue-600 text-white rounded-full px-2">
              0
            </span>
          </a>
          <a href="/orders" class="px-3 py-1.5 rounded-lg border border-blue-600 text-blue-600 bg-blue-50">
            Đơn hàng
          </a>
          <div class="bg-blue-50 text-blue-700 px-3 py-1 rounded-full">
            Xin chào, <strong><%= user.fullName %></strong>
          </div>
          <button
            id="logoutBtn"
            class="px-3 py-1.5 rounded-lg border border-slate-300 hover:bg-slate-50"
          >
            Đăng xuất
          </button>
        </div>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 py-6 space-y-6">
      <section class="bg-white rounded-2xl p-5 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <h1 class="text-2xl font-bold">Theo dõi đơn hàng</h1>
        </div>
        <div id="ordersNotice" class="hidden mb-4 rounded-lg bg-green-50 text-green-700 px-4 py-2 text-sm"></div>
        <div id="ordersList" class="space-y-4"></div>
      </section>
    </main>

    <script src="/public/js/nav.js"></script>
    <script src="/public/js/orders.js"></script>
  </body>
</html>
