<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Theo dõi lịch sử và trạng thái đơn hàng tại SneakerHub." />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/public/css/custom.css" />
    <title>Đơn hàng của tôi – SneakerHub</title>
  </head>
  <body>
    <!-- ══ HEADER ══════════════════════════════════════ -->
    <header class="site-header">
      <div style="max-width:1200px;margin:0 auto;padding:.75rem 1.25rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;">
        <a href="/" class="nav-logo">SneakerHub<span class="dot"></span></a>
        <nav style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;">
          <a href="/cart" class="nav-link" id="cartNavLink">
            🛒 Giỏ hàng
            <span id="cartCount" class="cart-badge">0</span>
          </a>
          <a href="/orders" class="nav-link active">📦 Đơn hàng</a>
          <span class="nav-user">👤 <strong><%= user.fullName %></strong></span>
          <button id="logoutBtn" class="nav-link" style="background:transparent;cursor:pointer;">Đăng xuất</button>
        </nav>
      </div>
    </header>

    <!-- ══ MAIN ════════════════════════════════════════ -->
    <main style="max-width:900px;margin:0 auto;padding:1.5rem 1.25rem;">

      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem;flex-wrap:wrap;gap:.5rem;">
        <h1 style="font-size:1.5rem;font-weight:900;letter-spacing:-.3px;">📦 Đơn hàng của tôi</h1>
        <a href="/" class="btn btn-outline btn-sm">← Tiếp tục mua sắm</a>
      </div>

      <!-- Notice (e.g. order placed success) -->
      <div id="ordersNotice" class="hidden" style="margin-bottom:1rem;background:var(--clr-primary-faint);color:var(--clr-primary-text);border:1px solid var(--clr-border);border-radius:var(--radius-md);padding:.7rem 1rem;font-size:.85rem;font-weight:500;"></div>

      <!-- Order list -->
      <div id="ordersList" style="display:flex;flex-direction:column;gap:1rem;"></div>
    </main>

    <script src="/public/js/nav.js"></script>
    <script src="/public/js/orders.js"></script>
  </body>
</html>
