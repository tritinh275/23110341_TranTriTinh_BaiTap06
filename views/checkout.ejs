<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/public/css/custom.css" />
    <title>Thanh toán đơn hàng</title>
  </head>
  <body class="bg-slate-100 text-slate-800">
    <header class="bg-white border-b border-slate-200 sticky top-0 z-10">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="text-xl font-bold text-blue-700">SneakerHub</a>
        <div class="flex items-center gap-3 text-sm">
          <a href="/cart" class="px-3 py-1.5 rounded-lg border border-slate-300 hover:bg-slate-50">
            Giỏ hàng
            <span id="cartCount" class="ml-1 inline-flex items-center justify-center text-xs bg-blue-600 text-white rounded-full px-2">
              0
            </span>
          </a>
          <a href="/orders" class="px-3 py-1.5 rounded-lg border border-slate-300 hover:bg-slate-50">Đơn hàng</a>
          <div class="bg-blue-50 text-blue-700 px-3 py-1 rounded-full">
            Xin chào, <strong><%= user.fullName %></strong>
          </div>
          <button
            id="logoutBtn"
            class="px-3 py-1.5 rounded-lg border border-slate-300 hover:bg-slate-50"
          >
            Đăng xuất
          </button>
        </div>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 py-6 space-y-6">
      <section class="bg-white rounded-2xl p-5 shadow-sm">
        <h1 class="text-2xl font-bold mb-4">Thanh toán đơn hàng</h1>
        <div id="checkoutEmpty" class="hidden text-slate-500">
          Giỏ hàng đang trống. <a href="/" class="text-blue-600 hover:underline">Quay về trang chủ</a>
        </div>
        <div id="checkoutContent" class="grid lg:grid-cols-2 gap-6">
          <div>
            <h2 class="text-lg font-semibold mb-3">Sản phẩm trong đơn</h2>
            <div id="checkoutItems" class="space-y-3"></div>
            <div id="checkoutSummary" class="mt-4 border-t border-slate-200 pt-4"></div>
          </div>

          <div>
            <h2 class="text-lg font-semibold mb-3">Thông tin nhận hàng</h2>
            <form id="checkoutForm" class="space-y-4">
              <div>
                <label class="block text-sm font-medium mb-1">Họ và tên</label>
                <input
                  id="recipientName"
                  name="recipientName"
                  class="w-full border rounded-lg px-3 py-2"
                  required
                />
              </div>
              <div>
                <label class="block text-sm font-medium mb-1">Số điện thoại</label>
                <input
                  id="phone"
                  name="phone"
                  class="w-full border rounded-lg px-3 py-2"
                  required
                />
              </div>
              <div>
                <label class="block text-sm font-medium mb-1">Địa chỉ</label>
                <textarea
                  id="address"
                  name="address"
                  class="w-full border rounded-lg px-3 py-2"
                  rows="3"
                  required
                ></textarea>
              </div>
              <div>
                <label class="block text-sm font-medium mb-1">Ghi chú (tuỳ chọn)</label>
                <textarea id="note" name="note" class="w-full border rounded-lg px-3 py-2" rows="2"></textarea>
              </div>
              <div class="bg-slate-50 border border-slate-200 rounded-lg p-3">
                <p class="text-sm text-slate-600 mb-2">Phương thức thanh toán</p>
                <label class="inline-flex items-center gap-2 text-sm font-medium">
                  <input type="radio" checked disabled />
                  COD (Thanh toán khi nhận hàng)
                </label>
              </div>
              <p id="checkoutError" class="text-sm text-red-600 hidden"></p>
              <button
                id="placeOrderBtn"
                class="w-full py-2.5 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700"
                type="submit"
              >
                Đặt hàng COD
              </button>
            </form>
          </div>
        </div>
      </section>
    </main>

    <script src="/public/js/nav.js"></script>
    <script src="/public/js/checkout.js"></script>
  </body>
</html>
