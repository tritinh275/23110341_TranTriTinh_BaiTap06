<!doctype html>
<html lang="vi">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="SneakerHub – Đăng nhập để mua sắm giày thể thao chính hãng." />
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/public/css/custom.css" />
  <title>Đăng nhập</title>
</head>

<body>
  <div class="login-wrapper">
    <!-- Brand side -->
    <div class="login-brand" style="display: flex; align-items: center; justify-content: center; text-align: center;">
      <div style="position:relative;z-index:1">
        <h2 style="font-size: 3rem; font-weight: 900; margin: 0;">Đăng nhập</h2>
      </div>
    </div>

    <!-- Form side -->
    <div class="login-form-side">
      <div class="login-box fade-up">
        <a href="/" class="nav-logo" style="font-size:1.1rem;margin-bottom:1.75rem;display:inline-flex;">
          SneakerHub<span class="dot"></span>
        </a>
        <h1 style="font-size:1.5rem;font-weight:800;margin-bottom:.25rem;letter-spacing:-.3px;">Chào mừng trở lại</h1>
        <p style="font-size:.85rem;color:var(--clr-muted);margin-bottom:1.5rem;">Đăng nhập vào tài khoản thành viên của
          bạn.</p>

        <form id="loginForm" style="display:flex;flex-direction:column;gap:1rem;">
          <div>
            <label class="form-label" for="username">Tên đăng nhập</label>
            <input id="username" class="form-input" name="username" autocomplete="username" required
              placeholder="Nhập tên đăng nhập" />
          </div>
          <div>
            <label class="form-label" for="password">Mật khẩu</label>
            <input id="password" class="form-input" name="password" type="password" autocomplete="current-password"
              required placeholder="••••••••" />
          </div>
          <button id="loginBtn" class="btn btn-primary btn-full btn-lg" type="submit" style="margin-top:.25rem;">
            Đăng nhập
          </button>
        </form>

        <p id="errorText" class="hidden"
          style="margin-top:.85rem;font-size:.82rem;color:#dc2626;background:#fee2e2;border:1px solid #fca5a5;border-radius:8px;padding:.5rem .75rem;">
        </p>

        <div style="margin-top:1.5rem;text-align:center;font-size:.85rem;color:var(--clr-muted);">
          Chưa có tài khoản? <a href="/register" style="color:var(--clr-primary);font-weight:600;text-decoration:underline;">Đăng ký ngay</a>
        </div>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById("loginForm");
    const errorText = document.getElementById("errorText");
    const loginBtn = document.getElementById("loginBtn");

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorText.classList.add("hidden");
      loginBtn.textContent = "Đang xử lý...";
      loginBtn.disabled = true;

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      const response = await fetch("/api/auth/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      const data = await response.json();
      if (!response.ok) {
        if (data.unverified) {
          window.location.href = `/verify-otp?username=${encodeURIComponent(payload.username)}`;
          return;
        }
        errorText.textContent = data.message || "Đăng nhập thất bại";
        errorText.classList.remove("hidden");
        loginBtn.textContent = "Đăng nhập";
        loginBtn.disabled = false;
        return;
      }
      window.location.href = "/";
    });
  </script>
</body>

</html>